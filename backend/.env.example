PORT=4000
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=https://pogoarcade.com

# Postgres connection — point this at a local Postgres for dev (see
# README "Local development"), or Cloud SQL in production. DB_HOST starting
# with "/" is treated as a Unix socket directory (used on Cloud Run); a
# plain hostname like "localhost" connects over TCP instead.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pogoarcade
DB_USER=postgres
DB_PASSWORD=
